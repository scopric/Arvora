# Copie para .env.local (fora do git). Valores locais: `supabase status` mostra a URL e a chave publicavel.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=
# Opcional: domínio público do site (canonical e hreflang). Sem ele, vale um endereço provisório.
#VITE_SITE_URL=https://exemplo.invalid
# Edge Function stripe-webhook (segredos via `supabase secrets set`, nunca aqui): um por conta Stripe,
# com o id de contas_stripe no nome. SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY o Supabase injeta.
#STRIPE_WEBHOOK_SECRET_<ID_DA_CONTA>=
# CAPTCHA Cloudflare Turnstile (opcional). Chave PÚBLICA do site; a chave secreta fica só no painel do Supabase (Authentication).
# Sem esta variável o widget não aparece e os formulários seguem como antes. Com ela, cadastro, entrar e recuperar senha pedem o token.
#VITE_TURNSTILE_SITE_KEY=
