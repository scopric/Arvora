{
  "name": "arvora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "react-router dev --port 5190",
    "build": "react-router typegen && tsc -b && react-router build && node scripts/externalizar-scripts.mjs && node scripts/gerar-robots-sitemap.mjs",
    "lint": "oxlint",
    "typecheck": "react-router typegen && tsc -b --noEmit",
    "preview": "npx serve build/client",
    "test": "vitest run",
    "types:gerar": "supabase gen types typescript --local --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@react-router/node": "8.5.1",
    "@supabase/supabase-js": "2.118.0",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "oxlint": "1.88.0",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
