# Copie para supabase/functions/.env (fora do git). Em produção, as mesmas variáveis vão nos segredos das Edge Functions.
# Base do site para success_url, cancel_url, return_url e CORS. Sem ela, as funções respondem 500.
SITE_URL=http://127.0.0.1:5190
# Chave secreta de cada conta Stripe: STRIPE_SECRET_KEY_<contas_stripe.id>. Sem ela, a conta responde 500 (sem chave reserva).
STRIPE_SECRET_KEY_1=
# Segredo de assinatura do endpoint do webhook de cada conta: STRIPE_WEBHOOK_SECRET_<contas_stripe.id>. Sem ele, o webhook responde 400.
STRIPE_WEBHOOK_SECRET_1=
# Já vêm da plataforma nas Edge Functions (não precisam estar aqui em produção); no teste local, copie de `supabase status -o env`:
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# criar-sala-meet: endereço do painel (alpha) para o CORS; sem ela, vale SITE_URL.
# ADMIN_URL=
# criar-sala-meet: cliente OAuth do Google Cloud da conta Workspace da Árvora, com a Google Meet REST API ligada,
# e refresh token dessa conta com o escopo https://www.googleapis.com/auth/meetings.space.created.
# Sem os três, o botão "Criar sala no Google Meet" responde 503 (meet_nao_configurado). Nunca versionar os valores.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REFRESH_TOKEN=
